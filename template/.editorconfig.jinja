root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8
max_line_length = {{ max_line_length }}
{% if indent_style == 'tab' -%}
indent_style = tab
{% else -%}
indent_style = space
indent_size = {{ indent_style }}
{% endif %}
{% if language == 'python' and indent_style != '4' -%}
[*.py]
indent_size = 4
{% endif %}
