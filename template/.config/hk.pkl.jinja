amends "package://github.com/jdx/hk/releases/download/v1.38.0/hk@1.38.0#/Config.pkl"
{% if languages | select('in', ['python', 'rust', 'shell', 'typescript', 'lua']) | list -%}
import "package://github.com/jdx/hk/releases/download/v1.38.0/hk@1.38.0#/Builtins.pkl"
{% endif %}
local linters = new Mapping<String, Step> {
{%- if 'shell' in languages %}
{%- if shell_type in ['bash', 'posix'] %}
  ["shellcheck"] = (Builtins.shellcheck) {
    prefix = "mise exec -- "
  }
  ["shfmt"] = (Builtins.shfmt) {
    prefix = "mise exec -- "
  }
{%- elif shell_type == 'zsh' %}
  ["zsh_syntax"] {
    glob = List("**/*.sh", "**/*.zsh")
    check = "zsh -n {{ '{{ files }}' }}"
  }
{%- endif %}
{%- endif %}
{%- if 'rust' in languages %}
  ["cargo_clippy"] = (Builtins.cargo_clippy) {
    prefix = "mise exec -- "
  }
  ["cargo_fmt"] = (Builtins.cargo_fmt) {
    prefix = "mise exec -- "
  }
{%- endif %}
{%- if 'python' in languages %}
  ["ruff"] = (Builtins.ruff) {
    prefix = "mise exec -- uv run "
  }
  ["ruff_format"] = (Builtins.ruff_format) {
    prefix = "mise exec -- uv run "
  }
  ["basedpyright"] {
    prefix = "mise exec -- uv run "
    glob = List("**/*.py", "**/*.pyi")
    check = "basedpyright {{ '{{ files }}' }}"
  }
{%- endif %}
{%- if 'typescript' in languages %}
  ["eslint"] = (Builtins.eslint) {
    prefix = "npx "
  }
  ["prettier"] = (Builtins.prettier) {
    prefix = "npx "
  }
  ["tsc"] = (Builtins.tsc) {
    prefix = "npx "
  }
{%- endif %}
{%- if 'lua' in languages %}
  ["stylua"] = (Builtins.stylua) {
    prefix = "mise exec -- "
  }
  ["selene"] = (Builtins.selene) {
    prefix = "mise exec -- "
  }
{%- endif %}
}
{% if 'python' in languages or 'shell' in languages or 'typescript' in languages -%}
local tests = new Mapping<String, Step> {
{%- if 'shell' in languages %}
{% if shell_type == 'bash' and shell_test_framework == 'bats' %}  ["bats"] {
    glob = List("**/*.sh", "**/*.bats")
    check = "mise exec -- bats tests/"
  }
{%- elif shell_type == 'bash' and shell_test_framework == 'shellspec' %}  ["shellspec"] {
    glob = List("**/*.sh", "spec/**/*_spec.sh")
    check = "mise exec -- shellspec"
  }
{%- else %}  ["shellspec"] {
    glob = List("**/*.sh", "spec/**/*_spec.sh")
    check = "mise exec -- shellspec"
  }
{%- endif %}
{%- endif %}
{%- if 'python' in languages %}
  ["pytest"] {
    glob = List("**/*.py")
    check = "mise exec -- uv run pytest"
  }
{%- endif %}
{%- if 'typescript' in languages %}
{% if ts_test_framework == 'vitest' %}  ["vitest"] {
    glob = List("**/*.ts")
    check = "npx vitest run"
  }
{%- else %}  ["node_test"] {
    glob = List("**/*.ts")
    check = "node --experimental-strip-types --test tests/index.test.ts"
  }
{%- endif %}
{%- endif %}
}
{% endif -%}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = linters
  }
  ["fix"] {
    fix = true
    steps = linters
  }
  ["check"] {
    steps {
      ...linters
{%- if 'python' in languages or 'shell' in languages or 'typescript' in languages %}
      ...tests
{%- endif %}
    }
  }
}
