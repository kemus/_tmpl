name: CI

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

permissions:
  contents: read

jobs:
  check:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
      - uses: jdx/mise-action@e79ddf65a11cec7b0e882bedced08d6e976efb2d # v3.6.2
        with:
          install: true
{% if language == 'python' %}      - run: mise exec -- uv sync
      - run: mise exec -- uv run pytest
{% elif language == 'typescript' %}      - run: npm install
{% endif %}      - run: mise exec -- hk check --no-progress --quiet
